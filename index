      <path d="M100 5 C 70 15, 55 35, 45 65" stroke="#8B9A7B" stroke-width="1.6" fill="none"/>
      <g transform="translate(48,62)">
        <circle cx="0" cy="-5" r="4" fill="#E7BEB6"/>
