  </div>

  <div class="scroll-hint"><span></span>Mehr erfahren</div>
</section>

<!-- ============ INTRO ============ -->
<section class="intro reveal" aria-label="Willkommen">
  <p>„Am Ufer des Wannsees, wo der Sommer am schönsten leuchtet, feiern wir den Beginn unseres gemeinsamen Weges. Wir freuen uns von Herzen, dieses Fest mit euch zu teilen.“
    <span class="sign">Christine &amp; Stefan</span>
  </p>
</section>

<!-- ============ LOCATION ============ -->
<section id="location" aria-label="Location">
  <div class="sec-head reveal">
    <p class="eyebrow">Wo wir feiern</p>
    <h2>Die Location</h2>
    <svg class="divider" viewBox="0 0 70 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 11 C 20 2, 25 20, 35 11 C 45 2, 50 20, 68 11" stroke="#C9A15A" stroke-width="1.4"/>
    </svg>
  </div>

  <div class="loc-card reveal">
    <div class="loc-grid">
      <div class="loc-info">
        <h3>Haus am Wannsee</h3>
        <p>
          Badeweg 7<br>
          14129 Berlin
        </p>
        <p style="margin-top:.9rem;">
          Direkt am Ufer des Wannsees gelegen — ein stimmungsvoller Rahmen für unseren gemeinsamen Tag.
        </p>
        <a class="btn" href="https://www.google.com/maps/search/?api=1&query=Badeweg+7,+14129+Berlin" target="_blank" rel="noopener">Route planen</a>
      </div>
      <svg class="lake" viewBox="0 0 260 180" xmlns="http://www.w3.org/2000/svg">
        <rect width="260" height="180" fill="#F3EAE0"/>
        <path d="M0 120 C 40 110, 60 130, 100 118 C 140 106, 160 128, 200 116 C 225 109, 245 118, 260 112 L260 180 L0 180 Z" fill="#8B9A7B" opacity="0.35"/>
