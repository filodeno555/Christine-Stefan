      </g>
    </svg>
  </div>

  <div id="petals-container" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="eyebrow">Wir heiraten</p>
    <h1 class="names">Christine<span class="amp">&amp;</span>Stefan</h1>
    <p class="hero-date">12. Juni 2027</p>
    <p class="hero-venue">Haus am Wannsee · Berlin</p>
    <p class="hero-venue">Beginn der Feier ab 15 Uhr</p>

    <div class="countdown" id="countdown" aria-label="Countdown bis zur Hochzeit">
      <div><span class="num" id="cd-days">00</span><span class="lbl">Tage</span></div>
