<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Christine & Stefan — Wir heiraten</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Mrs+Saint+Delafield&family=Jost:wght@300;400;500&display=swap');

  :root{
    --cream:#FBF6EF;
    --cream-deep:#F3EAE0;
    --blush:#E7BEB6;
    --rose:#C17F82;
    --rose-deep:#A85D63;
    --sage:#8B9A7B;
    --sage-deep:#6E7C5D;
    --wine:#6B2737;
    --gold:#C9A15A;
    --ink:#3A2E2A;
    --ink-soft:#6b5c54;
    --max:760px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:300;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{font-family:'Cormorant Garamond', serif; font-weight:500; color:var(--wine); letter-spacing:.01em;}
  a{color:inherit;}
  .eyebrow{
    font-family:'Jost', sans-serif;
    text-transform:uppercase;
    letter-spacing:.32em;
    font-size:.68rem;
    color:var(--sage-deep);
    font-weight:500;
  }
  :focus-visible{ outline:2px solid var(--rose-deep); outline-offset:3px; }
  section{position:relative; padding:6rem 1.5rem; max-width:var(--max); margin:0 auto;}

  /* ---------- vine spine (signature element) ---------- */
  .vine-spine{
    position:absolute; left:50%; top:0; bottom:0; width:2px;
    transform:translateX(-50%);
    background:linear-gradient(to bottom, transparent, var(--sage) 8%, var(--sage) 92%, transparent);
    opacity:.35;
    z-index:0;
  }
  .vine-spine::before, .vine-spine::after{
    content:""; position:absolute; left:50%; width:10px; height:10px; border-radius:50%;
    background:var(--blush); transform:translateX(-50%);
  }

  /* ---------- hero ---------- */
  .hero{
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:2rem 1.5rem;
    position:relative;
    background:
      radial-gradient(ellipse at 20% 15%, rgba(231,190,182,.35), transparent 45%),
      radial-gradient(ellipse at 82% 82%, rgba(139,154,123,.25), transparent 50%),
      var(--cream);
    overflow:hidden;
  }
  .hero-florals{position:absolute; inset:0; pointer-events:none; z-index:0;}
  .hero-florals svg{position:absolute;}
  .fl-tl{top:-20px; left:-30px; width:220px; opacity:.9;}
  .fl-br{bottom:-30px; right:-40px; width:260px; opacity:.9; transform:scaleX(-1);}
  .fl-tr{top:10px; right:6%; width:110px; opacity:.6; display:none;}

  .petal{
    position:absolute; width:14px; height:14px; opacity:0;
    animation:fall linear infinite;
  }
  @keyframes fall{
    0%{ transform:translateY(-40px) translateX(0) rotate(0deg); opacity:0; }
    8%{ opacity:.8; }
    92%{ opacity:.6; }
    100%{ transform:translateY(105vh) translateX(24px) rotate(220deg); opacity:0; }
  }

  .hero-content{position:relative; z-index:1;}
  .hero .eyebrow{margin-bottom:1.4rem;}
  .names{
    font-family:'Cormorant Garamond', serif;
    font-weight:500;
    font-size:clamp(2.6rem, 8vw, 4.6rem);
    line-height:1.05;
    color:var(--wine);
  }
  .amp{
    display:block;
    font-family:'Mrs Saint Delafield', cursive;
    font-weight:400;
    color:var(--rose-deep);
    font-size:clamp(2.6rem, 9vw, 4rem);
    margin:.1em 0;
  }
  .hero-date{
    margin-top:1.6rem;
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size:1.35rem;
    color:var(--ink-soft);
  }
  .hero-venue{
    margin-top:.35rem;
    font-size:.95rem;
    letter-spacing:.05em;
    color:var(--ink-soft);
  }

  .countdown{
    margin-top:2.6rem;
    display:flex; gap:1.6rem; justify-content:center; flex-wrap:wrap;
  }
  .countdown div{ text-align:center; min-width:64px; }
  .countdown .num{
    font-family:'Cormorant Garamond', serif; font-size:2.1rem; color:var(--wine); font-weight:600;
    display:block; line-height:1;
  }
  .countdown .lbl{ font-size:.62rem; letter-spacing:.18em; text-transform:uppercase; color:var(--sage-deep); }

  .scroll-hint{
    position:absolute; bottom:1.6rem; left:50%; transform:translateX(-50%);
    font-size:.65rem; letter-spacing:.25em; text-transform:uppercase; color:var(--sage-deep);
    display:flex; flex-direction:column; align-items:center; gap:.5rem;
    animation:bob 2.6s ease-in-out infinite;
  }
  .scroll-hint span{width:1px; height:26px; background:var(--sage);}
  @keyframes bob{ 0%,100%{transform:translateX(-50%) translateY(0);} 50%{transform:translateX(-50%) translateY(6px);} }

  /* ---------- reveal ---------- */
  .reveal{ opacity:0; transform:translateY(22px); transition:opacity .9s ease, transform .9s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }

  /* ---------- section heading ---------- */
  .sec-head{ text-align:center; margin-bottom:3rem; }
  .sec-head h2{ font-size:clamp(1.9rem,4.5vw,2.6rem); margin-top:.5rem; }
  .divider{
    width:70px; height:22px; margin:1.1rem auto 0; opacity:.75;
  }

  /* ---------- intro quote ---------- */
  .intro p{
    font-family:'Cormorant Garamond', serif; font-style:italic; font-size:1.5rem;
    line-height:1.55; text-align:center; color:var(--ink);
    max-width:560px; margin:0 auto;
  }
  .intro .sign{
    display:block; margin-top:1.4rem; font-family:'Mrs Saint Delafield', cursive;
    font-size:1.6rem; color:var(--rose-deep); font-style:normal;
  }

  /* ---------- timeline ---------- */
  .timeline{ margin-top:1rem; }
  .t-item{
    display:grid; grid-template-columns:100px 40px 1fr; gap:0 1.2rem; align-items:start;
    margin-bottom:2.6rem; background:var(--cream); position:relative; z-index:1;
  }
  .t-time{ font-family:'Cormorant Garamond', serif; font-size:1.3rem; color:var(--wine); text-align:right; padding-top:.15rem;}
  .t-dot-col{ display:flex; flex-direction:column; align-items:center; }
  .t-dot{
    width:13px; height:13px; border-radius:50%; background:var(--rose-deep); border:3px solid var(--cream);
    box-shadow:0 0 0 1.5px var(--sage); margin-top:.35rem;
  }
  .t-body h3{ font-size:1.25rem; margin-bottom:.25rem; }
  .t-body p{ color:var(--ink-soft); font-size:.92rem; line-height:1.55; }
  .t-note{
    margin-top:.4rem; display:inline-block; font-size:.72rem; letter-spacing:.05em;
    color:var(--sage-deep); font-style:italic; font-family:'Cormorant Garamond', serif;
  }

  /* ---------- location ---------- */
  .loc-card{
    background:var(--cream-deep); border-radius:2px; padding:2.4rem 2rem;
    position:relative; z-index:1;
    border:1px solid rgba(139,154,123,.3);
  }
  .loc-grid{ display:grid; grid-template-columns:1fr; gap:1.8rem; }
  .loc-info h3{ font-size:1.5rem; margin-bottom:.6rem; }
  .loc-info p{ line-height:1.8; color:var(--ink-soft); font-size:.95rem; }
  .loc-info a.btn{
    margin-top:1.1rem; display:inline-block;
  }
  .lake{ width:100%; height:auto; display:block; }

  .btn{
    font-family:'Jost',sans-serif; letter-spacing:.14em; text-transform:uppercase; font-size:.72rem;
    color:var(--cream); background:var(--wine); border:1px solid var(--wine);
    padding:.85rem 1.7rem; text-decoration:none; display:inline-block; transition:all .25s ease;
  }
  .btn:hover{ background:transparent; color:var(--wine); }
  .btn-outline{
    background:transparent; color:var(--wine);
  }
  .btn-outline:hover{ background:var(--wine); color:var(--cream); }

  /* ---------- rsvp ---------- */
  .rsvp-card{
    background:var(--cream); border:1px solid rgba(200,161,90,.5); padding:2.6rem 2rem;
    position:relative; z-index:1;
  }
  .field{ margin-bottom:1.4rem; }
  .field label{
    display:block; font-size:.72rem; letter-spacing:.14em; text-transform:uppercase;
    color:var(--sage-deep); margin-bottom:.5rem;
  }
  .field input, .field select, .field textarea{
    width:100%; border:none; border-bottom:1px solid rgba(107,39,55,.3);
    background:transparent; padding:.55rem .1rem; font-family:'Jost',sans-serif; font-size:1rem;
    color:var(--ink);
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-bottom-color:var(--rose-deep);
  }
  .field textarea{ resize:vertical; min-height:80px; }
  .row2{ display:grid; grid-template-columns:1fr; gap:0 1.4rem; }
  .submit-wrap{ text-align:center; margin-top:1.8rem; }
  .thanks{
    display:none; text-align:center; padding:1.4rem;
    font-family:'Cormorant Garamond', serif; font-size:1.3rem; color:var(--wine); font-style:italic;
  }

  /* ---------- footer ---------- */
  footer{
    text-align:center; padding:4rem 1.5rem 3rem; position:relative; z-index:1;
  }
  footer .amp{ font-size:2.2rem; margin-bottom:.3rem; }
  footer p{ font-size:.75rem; letter-spacing:.1em; color:var(--sage-deep); text-transform:uppercase; }

  @media(min-width:640px){
    .fl-tr{ display:block; }
    .loc-grid{ grid-template-columns:1.1fr .9fr; align-items:center; }
    .row2{ grid-template-columns:1fr 1fr; }
    section{ padding:8rem 2rem; }
  }

  @media (prefers-reduced-motion: reduce){
    .petal{ animation:none; display:none; }
    .scroll-hint{ animation:none; }
    .reveal{ transition:none; opacity:1; transform:none; }
  }
</style>
</head>
<body>

<div class="vine-spine" aria-hidden="true"></div>

<!-- ============ HERO ============ -->
